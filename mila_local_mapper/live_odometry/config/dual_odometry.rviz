Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Fixed Frame: odom
    Frame Rate: 20
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.5
    - Class: rviz_default_plugins/Path
      Name: Trajectory
      Enabled: true
      Topic:
        Value: /dual_odometry/path
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
      Color: 0; 210; 255
      Line Style: Lines
      Line Width: 0.025
      Buffer Length: 1
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 4
      Pitch: 0.85
      Yaw: 0.8
Window Geometry:
  Width: 1100
  Height: 750
